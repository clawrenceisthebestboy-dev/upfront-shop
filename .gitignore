# =============================================================
# Up Front Shop — .gitignore
# =============================================================

# -- Release signing key (Ed25519) — NEVER COMMIT --
# Generated by tools/gen_release_key.py. The private key must stay
# offline. The public key is pasted into app/updater.py as a constant.
release_signing_key.pem
release_public_key.hex

# -- Python cache / bytecode --
__pycache__/
*.py[cod]
*$py.class
*.so

# -- Virtual environments --
.venv/
venv/
env/
ENV/

# -- PyInstaller / Inno Setup build artifacts --
build/output/
build/UpFrontShop/
build/*.toc
build/*.pkg
dist/
*.exe
*.dmg
*.pkg
*.app

# -- Test / coverage --
.pytest_cache/
.coverage
htmlcov/
.tox/

# -- Editor / OS junk --
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# -- Env files / secrets --
.env
.env.*
*.env
secrets/
credentials/

# -- Local runtime data (should never appear here but just in case) --
*.sqlite
*.db
shop.db
